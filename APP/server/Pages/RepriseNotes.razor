@page "/reprise-notes"
@layout MainLayout
@inherits Pes.Pages.RepriseNotesComponent

@using Radzen
@using Radzen.Blazor
@using Pes.Models.DMdel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Authenticated, admin")]
<PageTitle>Reprise des notes</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H2" style="background-color: rgb(0, 120, 212); border-radius: 5px; color: #e6ecef; font-family: times new roman,times,serif; padding-bottom: 4px; padding-top: 2px; text-align: center" Text="Reprise des notes">
    </RadzenHeading>

    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Icon="warning" Size="AlertSize.Small" Style="border-radius: 8px; margin-top: 1rem;" Text="Cette page dédoublonne les évaluations et recalcule les notes selon la nouvelle formule (moyenne par rubrique puis moyenne pondérée par session). Lancez d'abord le diagnostic, puis lisez le rapport avant d'appliquer.">
    </RadzenAlert>

    <div class="row" style="margin-top: 1rem;">
      <div class="col-md-6">
        <RadzenText TextStyle="TextStyle.Caption" Style="display: block; margin-bottom: 0.35rem; font-weight: 600;">Session concernée</RadzenText>
        <RadzenDropDown AllowClear="false" Data="@(Sessions)" TextProperty="CodeSession" ValueProperty="Id" @bind-Value="@(sessionId)" Style="width: 100%;" Name="session">
        </RadzenDropDown>
      </div>
    </div>

    <div style="margin-top: 1.25rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="search" Text="1. Diagnostic (lecture seule)" Disabled="@(enCours || sessionId == 0)" Click="@DiagnosticAsync">
      </RadzenButton>
      <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="published_with_changes" Text="2. Appliquer la reprise" Disabled="@(enCours || !diagnosticFait || applique)" Click="@AppliquerAsync">
      </RadzenButton>
    </div>

    @if (enCours)
    {
      <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Icon="hourglass_top" Size="AlertSize.ExtraSmall" Style="border-radius: 8px; margin-top: 1rem;" Text="@(enCoursMessage)">
      </RadzenAlert>
    }

    @if (diagnosticFait)
    {
      <RadzenDataGrid AllowFiltering="false" AllowPaging="false" AllowSorting="false" Data="@(rapport)" class="rz-datatable rz-datatable-scrollable" TItem="RapportLigne" Style="margin-top: 1.25rem;">
        <Columns>
          <RadzenDataGridColumn TItem="RapportLigne" Property="Libelle" Title="Indicateur" Width="380px">
          </RadzenDataGridColumn>
          <RadzenDataGridColumn TItem="RapportLigne" Property="Valeur" Title="Valeur" TextAlign="TextAlign.Center" Width="160px">
          </RadzenDataGridColumn>
        </Columns>
      </RadzenDataGrid>
    }

    @if (applique)
    {
      <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" Icon="check_circle" Size="AlertSize.Small" Style="border-radius: 8px; margin-top: 1rem;" Text="@(messageFinal)">
      </RadzenAlert>
    }
  </ChildContent>
</RadzenContent>

@page "/audit-logs"
@layout MainLayout
@inherits Pes.Pages.AuditLogsComponent

@using Radzen
@using Radzen.Blazor
@using Pes.Models
@using Microsoft.AspNetCore.Identity;
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles="admin")]
<PageTitle>Journal d'audit</PageTitle>
<RadzenContent Container="main">
  <ChildContent>
    <RadzenHeading Size="H2" style="background-color: rgb(0, 120, 212); border-radius: 5px; color: #e6ecef; font-family: times new roman,times,serif; padding-bottom: 4px; padding-top: 2px; text-align: center" Text="Journal d'audit">
    </RadzenHeading>
    <div class="row">
      <div class="col-md-12">
        <RadzenDropDown AllowClear="true" AllowFiltering="true" Data="@UserNames" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="Filtrer par utilisateur" style="margin-bottom: 10px; margin-right: 10px; width: 250px" @bind-Value="@SelectedUserName" Name="UserFilterDropdown" Change="@FilterChange">
        </RadzenDropDown>
        <RadzenDatePicker AllowClear="true" DateFormat="dd/MM/yyyy" Placeholder="Date début" style="margin-bottom: 10px; margin-right: 10px; width: 160px" @bind-Value="@FilterDateFrom" Change="@((args) => OnFilterChanged())" Name="DateFromFilter">
        </RadzenDatePicker>
        <RadzenDatePicker AllowClear="true" DateFormat="dd/MM/yyyy" Placeholder="Date fin" style="margin-bottom: 10px; margin-right: 10px; width: 160px" @bind-Value="@FilterDateTo" Change="@((args) => OnFilterChanged())" Name="DateToFilter">
        </RadzenDatePicker>
        <RadzenButton Icon="filter_alt_off" style="margin-bottom: 10px; margin-right: 10px" Text="Réinitialiser" Click="@ClearFiltersClick">
        </RadzenButton>
        <RadzenButton Icon="refresh" style="margin-bottom: 10px" Text="Rafraîchir" Click="@RefreshButtonClick">
        </RadzenButton>
        <RadzenDataGrid @ref="grid0" AllowFiltering="true" AllowPaging="true" AllowSorting="true" Data="@FilteredAuditLogs" FilterMode="Radzen.FilterMode.Advanced" TItem="Pes.Models.AuditLog" PageSize="50" Density="Density.Compact">
          <Columns>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="Timestamp" Title="Date" Width="150px">
              <Template Context="auditLog">
                @auditLog.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
              </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="UserName" Title="Utilisateur" Width="150px">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="Action" Title="Action" Width="130px">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="EntityType" Title="Entité" Width="130px">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="EntityId" Title="Id" Width="90px">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="Summary" Title="Résumé">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="Source" Title="Source" Width="90px">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Property="IpAddress" Title="Adresse IP" Width="130px">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Pes.Models.AuditLog" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="70px">
              <Template Context="auditLog">
                <RadzenButton Icon="visibility" Size="ButtonSize.Small" Click="@((args) => DetailsButtonClick(args, auditLog))">
                </RadzenButton>
              </Template>
            </RadzenDataGridColumn>
          </Columns>
        </RadzenDataGrid>
      </div>
    </div>
  </ChildContent>
</RadzenContent>

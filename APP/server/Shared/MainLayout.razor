@inherits Pes.Layouts.MainLayoutComponent

@using Radzen
@using Radzen.Blazor
@using Pes.Models.DMdel
@using Microsoft.AspNetCore.Identity;
@using Pes.Models
@using Pes.Pages

<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<RadzenLayout>
    <ChildContent>
        <RadzenHeader Class="pes-header">
            <ChildContent>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Style="height: 100%; width: 100%;">
                    
                    <!-- Left: Brand Logo & Title & Navigation Menu -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <NavLink href="accueil" class="pes-brand">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.65rem">
                                    <RadzenImage Path="assets/images/mesrs-logo.png" AlternateText="MESRS Logo" Class="pes-brand-logo" Style="height: 64px; width: auto;" />
                                    <RadzenStack Orientation="Orientation.Vertical" Gap="1px">
                                        <RadzenText TextStyle="TextStyle.H6" Class="pes-brand-title" Style="color: #ffffff !important; vertical-align: middle; line-height: 1.15;">DigiWeek &bull; MESRS</RadzenText>
                                   </RadzenStack>
                                </RadzenStack>
                            </NavLink>

                            <!-- Navigation Menu -->
                            <RadzenMenu Class="pes-menu">
                                <ChildContent>
                                    <RadzenMenuItem Icon="login" Path="login" Text="Se connecter" Visible="@(!Security.IsAuthenticated())">
                                    </RadzenMenuItem>

                                    <RadzenMenuItem Icon="home" Path="accueil" Text="Accueil" Visible="@Security.IsAuthenticated()">
                                    </RadzenMenuItem>

                                    <RadzenMenuItem Icon="assignment_turned_in" Path="stagiaires-evaluations" Text="Évaluation" Visible="@Security.IsInRole(new string[]{"Authenticated", "admin", "admin_regional", "coordinateur", "expert", "membre_jury", "president_jury"})">
                                    </RadzenMenuItem>

                                    <RadzenMenuItem Icon="leaderboard" Path="rang-etabs" Text="Classement" Visible="@(Security.IsInRole(new string[]{Constants.admin, Constants.admin_regional, Constants.coordinateur}))">
                                    </RadzenMenuItem>

                                    <RadzenMenuItem Icon="insights" Path="statistiques" Text="Statistiques" Visible="@Security.IsInRole(new string[]{"Authenticated", "admin", "admin_regional", "coordinateur", "expert", "membre_jury", "president_jury"})">
                                    </RadzenMenuItem>

                                    <RadzenMenuItem Icon="tune" Text="Paramétrage" Visible="@(Security.IsInRole(Constants.admin))">
                                        <ChildContent>
                                            <RadzenMenuItem Class="pes-menu-section" Disabled="true" Text="Territoire">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="map" Path="regions" Text="Régions" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="apartment" Path="etablissement-liste" Text="Établissements" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="calendar_month" Path="sessions" Text="Sessions" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>

                                            <RadzenMenuItem Class="pes-menu-section" Disabled="true" Text="Grille d'évaluation">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="category" Path="rubriques" Text="Rubriques" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="fact_check" Path="element" Text="Indicateurs & Critères" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="linear_scale" Path="echelle" Text="Échelles" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>

                                            <RadzenMenuItem Class="pes-menu-section" Disabled="true" Text="Sécurité">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="history" Path="audit-logs" Text="Journal d'audit" Visible="@(Security.IsInRole(Constants.admin))">
                                            </RadzenMenuItem>
                                        </ChildContent>
                                    </RadzenMenuItem>

                                    <RadzenMenuItem Icon="admin_panel_settings" Text="Gestion" Visible="@(Security.IsInRole(new string[]{Constants.admin, Constants.admin_regional, Constants.coordinateur}))">
                                        <ChildContent>
                                            <RadzenMenuItem Icon="school" Path="stagiairelist" Text="Stagiaires" Visible="@(Security.IsInRole(new string[]{Constants.admin, Constants.admin_regional, Constants.coordinateur}))">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="domain" Path="facultes" Text="Facultés & Départements" Visible="@(Security.IsInRole(new string[]{Constants.admin, Constants.admin_regional, Constants.coordinateur}))">
                                            </RadzenMenuItem>
                                            <RadzenMenuItem Icon="manage_accounts" Path="application-users" Text="Utilisateurs" Visible="@(Security.IsInRole(new string[]{Constants.admin, Constants.admin_regional, Constants.coordinateur}))">
                                            </RadzenMenuItem>
                                        </ChildContent>
                                    </RadzenMenuItem>
                                </ChildContent>
                            </RadzenMenu>
                    </RadzenStack>

                    <!-- Right: Context Badges & Profile Menu -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        @if (Security.IsAuthenticated())
                        {
                            @if (Globals.ActiveSession != null)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat" IsPill="true" Class="d-none d-lg-inline-flex" Style="padding: 0.35rem 0.75rem; font-size: 0.75rem; font-weight: 600;">
                                    <RadzenIcon Icon="calendar_month" Style="font-size: 13px; margin-right: 4px; vertical-align: middle;" />
                                    @Globals.ActiveSession.NomSession
                                </RadzenBadge>
                            }

                            <RadzenProfileMenu Class="pes-profile-menu" Visible="@(Security.IsAuthenticated())" Click="@Profilemenu0Click">
                                <ChildContent>
                                    <RadzenProfileMenuItem Icon="account_circle" Path="profile" Text="Mon profil" Value="Profile" Visible="@Security.IsInRole(new string[]{"Authenticated"})">
                                    </RadzenProfileMenuItem>
                                    <RadzenProfileMenuItem Icon="logout" Text="Se déconnecter" Value="Logout">
                                    </RadzenProfileMenuItem>
                                </ChildContent>
                                <Template>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenGravatar Email="@(Security.User?.Name)" Class="pes-user-avatar">
                                        </RadzenGravatar>
                                        <RadzenStack Orientation="Orientation.Vertical" Gap="0" Class="d-none d-md-flex text-left" Style="text-align: left;">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-size: 0.85rem; font-weight: 600; line-height: 1.2; color: #ffffff !important;">
                                                @(Security.User?.Name)
                                            </RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; font-size: 0.72rem; color: rgba(255, 255, 255, 0.85) !important; line-height: 1.1;">
                                                @(Globals.Etab?.NomEtablissement ?? "Connecté")
                                            </RadzenText>
                                        </RadzenStack>
                                        <RadzenIcon Icon="expand_more" Style="font-size: 18px; color: rgba(255, 255, 255, 0.85); margin-left: 2px;" />
                                    </RadzenStack>
                                </Template>
                            </RadzenProfileMenu>
                        }
                        else
                        {
                            <RadzenButton Text="Se connecter" Icon="login" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Variant="Variant.Filled" Click="@(() => UriHelper.NavigateTo("login"))" Style="font-weight: 600; border-radius: 6px;" />
                        }
                    </RadzenStack>

                </RadzenStack>
            </ChildContent>
        </RadzenHeader>

        <!-- Main Body -->
        <RadzenBody @ref="body0" Class="pes-body">
            <ChildContent>
                <RadzenContentContainer Name="main">
                    @Body
                </RadzenContentContainer>
            </ChildContent>
        </RadzenBody>

        <!-- Modern Footer -->
        <RadzenFooter Class="pes-footer">
            <ChildContent>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.75rem" Style="width: 100%;">
                    
                    <!-- Left: App & Copyright Info & GitHub Link -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="school" Style="color: var(--rz-primary, #0078d4); font-size: 1.15rem;" />
                            <RadzenText TextStyle="TextStyle.Body2" Class="pes-footer-text" Style="margin: 0; font-weight: 600; color: var(--rz-text-color, #334155);">
                                DigiWeek &copy; @DateTime.Now.Year &bull; MESRS
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Class="pes-footer-text d-none d-sm-inline" Style="margin: 0;">
                                &mdash; Plateforme d'Évaluation des Stagiaires
                            </RadzenText>
                        </RadzenStack>

                       
                    </RadzenStack>

                    <!-- Right: User Context Badges -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @if (Globals.ActiveSession != null)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Primary" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Style="padding: 0.25rem 0.65rem; font-size: 0.75rem; font-weight: 500;">
                                <RadzenIcon Icon="event" Style="font-size: 13px; margin-right: 3px; vertical-align: middle;" />
                                Session : @Globals.ActiveSession.NomSession
                            </RadzenBadge>
                        }

                        @if (Globals.Etab != null)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Class="d-none d-md-inline-flex" Style="padding: 0.25rem 0.65rem; font-size: 0.75rem; font-weight: 500;">
                                <RadzenIcon Icon="apartment" Style="font-size: 13px; margin-right: 3px; vertical-align: middle;" />
                                @Globals.Etab.NomEtablissement
                            </RadzenBadge>
                        }

                        @if (Security.User != null)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Style="padding: 0.25rem 0.65rem; font-size: 0.75rem; font-weight: 500;">
                                <RadzenIcon Icon="person" Style="font-size: 13px; margin-right: 3px; vertical-align: middle;" />
                                @Security.User.Name
                            </RadzenBadge>
                        }
                    </RadzenStack>

                </RadzenStack>
            </ChildContent>
        </RadzenFooter>
    </ChildContent>
</RadzenLayout>

